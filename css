* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  background: #000;
  color: #fff;
  overflow: hidden;
  height: 100vh;
}

.app {
  display: flex;
  height: calc(100vh - 80px);
  overflow: hidden;
}

.sidebar {
  width: 280px;
  background: #000;
  padding: 20px 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  overflow-y: auto;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 16px;
  margin-bottom: 12px;
}

.logo svg {
  background: #1db954;
  border-radius: 50%;
}

.logo span {
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.5px;
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 10px 16px;
  color: #b3b3b3;
  text-decoration: none;
  font-weight: 600;
  font-size: 14px;
  border-radius: 8px;
  transition: color 0.2s;
}

.nav-item:hover,
.nav-item.active {
  color: #fff;
}

.library {
  background: #121212;
  border-radius: 8px;
  padding: 12px 8px;
  margin-top: 8px;
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.playlist-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px;
  border-radius: 6px;
  cursor: pointer;
  transition: background 0.2s;
}

.playlist-card:hover {
  background: rgba(255, 255, 255, 0.1);
}

.playlist-icon {
  width: 48px;
  height: 48px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
}

.playlist-icon.liked {
  background: linear-gradient(135deg, #450af5, #c4efd9);
}

.playlist-icon.chill {
  background: #1e3264;
}

.playlist-icon.workout {
  background: #e8115b;
}

.playlist-icon.focus {
  background: #148a08;
}

.playlist-info {
  min-width: 0;
}

.playlist-name {
  font-size: 14px;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.playlist-desc {
  font-size: 12px;
  color: #b3b3b3;
  margin-top: 2px;
}

.main-content {
  flex: 1;
  background: #121212;
  overflow-y: auto;
  border-radius: 8px;
  margin: 8px 8px 0 0;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 24px;
  position: sticky;
  top: 0;
  background: rgba(18, 18, 18, 0.9);
  backdrop-filter: blur(10px);
  z-index: 10;
}

.topbar-nav {
  display: flex;
  gap: 8px;
}

.nav-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.7);
  color: #fff;
  border: none;
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-menu {
  display: flex;
  align-items: center;
}

.avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #1db954;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
}

.greeting {
  padding: 16px 24px 8px;
}

.greeting h1 {
  font-size: 28px;
  font-weight: 700;
}

.quick-picks {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 12px;
  padding: 8px 24px 24px;
}

.pick-card {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.07);
  border-radius: 6px;
  overflow: hidden;
  cursor: pointer;
  transition: background 0.2s;
}

.pick-card:hover {
  background: rgba(255, 255, 255, 0.15);
}

.pick-img {
  width: 56px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
}

.pick-card span {
  padding: 0 16px;
  font-weight: 600;
  font-size: 14px;
}

.section {
  padding: 0 24px 24px;
}

.section h2 {
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 16px;
}

.card-row {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  padding-bottom: 8px;
}

.card {
  min-width: 170px;
  max-width: 170px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 8px;
  padding: 14px;
  cursor: pointer;
  transition: background 0.2s;
}

.card:hover {
  background: rgba(255, 255, 255, 0.1);
}

.card-img {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48px;
  margin-bottom: 12px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
}

.card-title {
  font-size: 14px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-sub {
  font-size: 12px;
  color: #b3b3b3;
  margin-top: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.player-bar {
  height: 80px;
  background: #181818;
  border-top: 1px solid #282828;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
}

.player-left {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 200px;
  flex: 1;
}

.player-thumb {
  width: 56px;
  height: 56px;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
}

.player-track {
  min-width: 0;
}

.track-name {
  font-size: 14px;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.track-artist {
  font-size: 12px;
  color: #b3b3b3;
  margin-top: 2px;
}

.player-btn {
  background: none;
  border: none;
  color: #b3b3b3;
  cursor: pointer;
  font-size: 16px;
  padding: 4px;
  transition: color 0.2s;
}

.player-btn:hover {
  color: #fff;
}

.like-btn:hover {
  color: #1db954;
}

.player-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  max-width: 600px;
  flex: 2;
}

.player-controls {
  display: flex;
  align-items: center;
  gap: 16px;
}

.ctrl-btn {
  background: none;
  border: none;
  color: #b3b3b3;
  cursor: pointer;
  font-size: 16px;
  padding: 4px;
  transition: color 0.2s;
}

.ctrl-btn:hover {
  color: #fff;
}

.play-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #fff;
  color: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  padding: 0;
}

.play-btn:hover {
  transform: scale(1.06);
  color: #000;
}

.progress-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
}

.time {
  font-size: 11px;
  color: #b3b3b3;
  min-width: 36px;
  text-align: center;
}

.progress-track,
.volume-track {
  flex: 1;
  height: 4px;
  background: #4d4d4d;
  border-radius: 2px;
  position: relative;
  cursor: pointer;
}

.progress-fill {
  width: 30%;
  height: 100%;
  background: #fff;
  border-radius: 2px;
}

.volume-track {
  flex: unset;
  width: 100px;
}

.volume-fill {
  width: 70%;
  height: 100%;
  background: #fff;
  border-radius: 2px;
}

.player-right {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 200px;
  flex: 1;
  justify-content: flex-end;
}

@media (max-width: 900px) {
  .sidebar {
    display: none;
  }

  .main-content {
    margin-left: 8px;
  }

  .quick-picks {
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }
}

@media (max-width: 600px) {
  .player-left,
  .player-right {
    display: none;
  }

  .player-center {
    flex: 1;
  }
}
